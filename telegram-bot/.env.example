# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=

# Groq API key (https://console.groq.com/keys)
GROQ_API_KEY=

# Folder containing your .md documentation files (absolute or relative to project root)
DOCS_DIR=./docs

# Optional overrides
GROQ_MODEL=llama-3.3-70b-versatile
TOP_K=5
MEMORY_TURNS=8
CHUNK_SIZE=500
CHUNK_OVERLAP=50
